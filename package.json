{
  "name": "naturanza-food",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "rm -rf node_modules",
    "postinstall": "npm --prefix backend install && npm --prefix frontend install --include=dev && (chmod +x frontend/node_modules/@esbuild/linux-x64/bin/esbuild 2>/dev/null || true) && npm --prefix frontend run build && npm run build:next",
    "dev": "node start-dev.js",
    "dev:check": "node start-dev.js --check-only",
    "dev:unix": "node start-dev.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:next": "next dev",
    "build": "npm --prefix frontend run build && npm run build:next",
    "build:next": "next build",
    "start": "node backend/index.js",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "tsc --noEmit",
    "preview": "npm --prefix frontend run preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "framer-motion": "^12.43.0",
    "mysql2": "^3.22.0",
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "A modern, full-stack e-commerce application built with React, Node.js, Express, and MySQL.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehar99197/naturanza-food.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mehar99197/naturanza-food/issues"
  },
  "homepage": "https://github.com/mehar99197/naturanza-food#readme"
}
